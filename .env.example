# ==============================================================================
# Garmin Connect AI Coach Backend - Environment Variables Configuration
# ==============================================================================

# Chiave API segreta per proteggere tutti gli endpoint.
# ChatGPT Custom Action invierà questa chiave nell'header (X-API-Key o Bearer Token).
# Genera una chiave sicura (es. con: python -c "import secrets; print(secrets.token_hex(24))")
API_KEY=garmin_ai_coach_secret_key_change_me_123456

# URL pubblico del backend esposto su Internet (HTTPS obbligatorio per ChatGPT Action)
# Es: https://garmin-backend.up.railway.app oppure https://xyz.onrender.com
# Durante i test locali puoi usare un tunnel Cloudflare o Ngrok (es. https://abc.ngrok-free.app)
SERVER_URL=https://your-public-backend-url.com

# Credenziali Garmin Connect (usate dallo script setup_auth.py per il primo login con MFA)
GARMIN_EMAIL=tuo_indirizzo_email@garmin.com
GARMIN_PASSWORD=tua_password_sicura_garmin

# Percorso locale della cartella in cui salvare i token di sessione generati (default: ./tokens)
GARMIN_TOKENS_DIR=./tokens

# [OPZIONALE PER DEPLOY CLOUD SENZA DISCO PERSISTENTE]:
# Stringa JSON/Base64 generata da setup_auth.py.
# Se impostata, il backend caricherà la sessione direttamente da questa variabile
# senza aver bisogno di file su disco (ideale per Render o Railway).
GARMIN_TOKENS_BASE64=
